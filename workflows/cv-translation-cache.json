        "jsCode": "let cvText = '';\nlet guideText = '';\nconst jobPostLanguage = $('Start').first().json.job_post_language;\n\ntry {\n  cvText = $('CV Translator').first().json.text || '';\n} catch (e) {}\n\nif (!cvText) {\n  try {\n    cvText = $('Pivot CV Cache Rows').first().json['translated_cv_text_' + $('Start').first().json.job_post_language] || '';\n  } catch (e) {}\n}\n\nif (!cvText) {\n  cvText = $('Start').first().json.cv_text || '';\n}\n\nreturn [{\n  json: {\n    cv_text_final: cvText\n  }\n}];"
